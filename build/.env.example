# Copy to build/.env and fill in. build/.env is gitignored; never commit it.
# Keep the keystore, .p8 key and Play JSON outside the repo too.

# --- Apple (macos.sh, ios.sh) ---------------------------------------------------
# Team ID: developer.apple.com > Account > Membership details
APPLE_TEAM_ID=

# App Store Connect API key (Users and Access > Integrations > App Store Connect API).
# Role "App Manager" is enough. Used for notarizing, uploading and iOS signing.
# The file must keep Apple's name: AuthKey_<key id>.p8
APPLE_API_KEY=
APPLE_API_ISSUER=
APPLE_API_KEY_PATH=$HOME/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Direct-download .dmg. Find names with: security find-identity -v -p codesigning
APPLE_DEVELOPER_ID_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Mac App Store
MAS_APP_IDENTITY="Apple Distribution: Your Name (TEAMID)"
MAS_INSTALLER_IDENTITY="3rd Party Mac Developer Installer: Your Name (TEAMID)"
MAS_PROVISION_PROFILE=$HOME/.appstoreconnect/Wryter_Mac_App_Store.provisionprofile

# --- Android (android.sh) -------------------------------------------------------
# Upload key. Create once with:
#   keytool -genkeypair -v -keystore ~/keys/wryter-upload.jks -keyalg RSA \
#     -keysize 2048 -validity 10000 -alias upload
ANDROID_KEYSTORE=$HOME/keys/wryter-upload.jks
ANDROID_KEY_ALIAS=upload
ANDROID_KEYSTORE_PASSWORD=
# Only if the key password differs from the keystore password
ANDROID_KEY_PASSWORD=

# Optional overrides; android.sh finds these on its own when unset
# ANDROID_HOME=$HOME/Android/Sdk
# NDK_HOME=$HOME/Android/Sdk/ndk/28.2.13676358
# JAVA_HOME=/usr/lib/jvm/java-21-openjdk

# Google Play upload (android.sh --upload). Service account JSON key, see build/README.md
PLAY_SERVICE_ACCOUNT_JSON=$HOME/keys/wryter-play.json
# internal | alpha | beta | production
PLAY_TRACK=internal
# draft (you roll it out in Play Console) | completed (live on the track immediately)
PLAY_RELEASE_STATUS=draft
